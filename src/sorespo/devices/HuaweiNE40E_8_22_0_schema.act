        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='name', config=True, description='Specify the name of a peer group. The value is a string of characters, spaces not supported.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 47)]), patterns=[YangPattern(yang_regex='([^\\? ]+)', pcre='^(([^\\? ]+))$', invert=False)])),
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='type', config=True, description='Specify the type of a peer group. The value can be IBGP or EBGP.The object cannot be modified.', is_key=False, mandatory=True, type=DTypeEnum(name='group-type', description='The type of bgp common peer.', reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'ebgp':1, 'ibgp':2}), exts=[
                DExt(module='huawei-extension', namespace='urn:huawei:yang:huawei-extension', prefix='ext', name='operation-exclude', arg='update', exts=[])
            ]),
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='local-if-name', config=True, description='Name of a source interface that sends BGP packets. By default, the outbound interface of a BGP packet serves as the source interface of a BGP packet. To ensure that a router can send BGP packets when a physical interface fails, you can configure the source interface that sends BGP packets as a loopback interface. When using the loopback interface as the source interface, note the following points: 1. The address of the loopback interface of the BGP peer must be reachable. 2. For an EBGP connection, configure the maximum number of hops and allow EBGP peer relationships to be established in indirect mode.', is_key=False, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('ifm', 'ifm', []), yxpath.NodeTestStep('ifm', 'interfaces', []), yxpath.NodeTestStep('ifm', 'interface', []), yxpath.NodeTestStep('ifm', 'name', [])]), require_instance=False, target_type=DTypeString(name='pub-type:if-name', description='Interface name is like Ethernet1/1/1/1.', reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 63)]), patterns=[]))),
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='password-type', config=True, description='Enable BGP peers to establish a TCP connection and perform the Message Digest 5 (MD5) authentication for BGP messages. Plaintexts and ciphertexts are supported.', default='null', is_key=False, mandatory=False, must=[
DMust(condition="not(../password-type!='null' and (../key-chain-name or ../tcp-ao-name))", description=None, error_app_tag=None, error_message=None, reference=None)
            ], type=DTypeEnum(name='bgp:password-type', description='The type of bgpcommPassword.', reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'null':0, 'cipher':1, 'simple':2})),
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='password-text', config=True, description='Enable BGP peers to establish a TCP connection and perform the Message Digest 5 (MD5) authentication for BGP messages. The character string in a password identifies the contents of the password, spaces not supported. The TCP connection can be established only when the same MD5 authentication password is set on both ends. If a plaintext is used, the maximum password length is 255. If a ciphertext is used, the maximum password length is 432. If the length is set to 0, no password is set.', is_key=False, mandatory=True, type=DTypeString(name='pub-type:password-extend', description='The password is a string ranging from 1 to 255 characters for a unencrypted password and 20 to 432 characters for a encrypted password.', reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 432)]), patterns=[]), when="../password-type!='null'"),
        DContainer(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='afs', config=True, description='List of all peer groups that are enabled in a specified address family.', presence=False, children=[
