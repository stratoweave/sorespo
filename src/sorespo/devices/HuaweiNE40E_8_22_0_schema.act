            ], type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None)),
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='as', config=True, description='Local AS number, which can be in either of the two formats:\nThe two-byte format is X. X is an integer ranging from 1 to 65535.\nThe four-byte format is X.Y and X. When the format is X.Y, X and Y are both integers, with the value of X ranging from 1 to 65535, and the value of Y ranging from 0 to 65535; when the format is X, X is an interger, with the value ranging from 1 to 4294967295.\nAn AS consists of multiple routers managed based on the same techniques. Interior Gateway Protocol (IGP) and universal routing metric packets are used inside an AS, and Exterior Gateway Protocol (EGP) is used outside to send packets to other ASs. With the development of this definition, one AS usually uses multiple IGPs and metrics. Even though multiple IGPs and metrics are used, the routing plan and destination reachability of an AS are consistent with those of another AS. The local AS number cannot be configured same as the confederation sub-ASs. The object cannot be deleted or modified.', is_key=False, mandatory=False, type=DTypeString(name='as-number-validate', description='AS number is not include.', reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 11)]), patterns=[YangPattern(yang_regex='((([1-9]\\d{{0,8}})|([1-3]\\d{{9}})|(4[0-1]\\d{{8}})|(42[0-8]\\d{{7}})|(429[0-3]\\d{{6}})|(4294[0-8]\\d{{5}})|(42949[0-5]\\d{{4}})|(429496[0-6]\\d{{3}})|(4294967[0-1]\\d{{2}})|(42949672[0-8]\\d{{1}})|(429496729[0-5]))|((([1-9]\\d{{0,3}})|([1-5]\\d{{4}})|(6[0-4]\\d{{3}})|(65[0-4]\\d{{2}})|(655[0-2]\\d)|(6553[0-5]))[\\.](([0-9]\\d{{0,3}})|([1-5]\\d{{4}})|(6[0-4]\\d{{3}})|(65[0-4]\\d{{2}})|(655[0-2]\\d)|(6553[0-5]))))', pcre='^(((([1-9]\\p{{Nd}}{{0,8}})|([1-3]\\p{{Nd}}{{9}})|(4[0-1]\\p{{Nd}}{{8}})|(42[0-8]\\p{{Nd}}{{7}})|(429[0-3]\\p{{Nd}}{{6}})|(4294[0-8]\\p{{Nd}}{{5}})|(42949[0-5]\\p{{Nd}}{{4}})|(429496[0-6]\\p{{Nd}}{{3}})|(4294967[0-1]\\p{{Nd}}{{2}})|(42949672[0-8]\\p{{Nd}}{{1}})|(429496729[0-5]))|((([1-9]\\p{{Nd}}{{0,3}})|([1-5]\\p{{Nd}}{{4}})|(6[0-4]\\p{{Nd}}{{3}})|(65[0-4]\\p{{Nd}}{{2}})|(655[0-2]\\p{{Nd}})|(6553[0-5]))\\.(([0-9]\\p{{Nd}}{{0,3}})|([1-5]\\p{{Nd}}{{4}})|(6[0-4]\\p{{Nd}}{{3}})|(65[0-4]\\p{{Nd}}{{2}})|(655[0-2]\\p{{Nd}})|(6553[0-5])))))$', invert=False)]), when="../enable='true'", exts=[
                DExt(module='huawei-extension', namespace='urn:huawei:yang:huawei-extension', prefix='ext', name='operation-exclude', arg='update', exts=[])
            ])
    ])
])

