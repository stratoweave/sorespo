        DLeaf(module='huawei-isis', namespace='urn:huawei:yang:huawei-isis', prefix='isis', name='interface', config=False, description='Set the interface name.', is_key=False, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, units=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('ifm', 'ifm', []), yxpath.NodeTestStep('ifm', 'interfaces', []), yxpath.NodeTestStep('ifm', 'interface', []), yxpath.NodeTestStep('ifm', 'name', [])]), require_instance=False, target_type=DTypeString(name='pub-type:if-name', description='Interface name is like Ethernet1/1/1/1.', reference=None, units=None, exts=[], builtin_type='string', default=None, length=Ranges([(1, 63)]), patterns=[]))),
        DLeaf(module='huawei-isis', namespace='urn:huawei:yang:huawei-isis', prefix='isis', name='notify-peer', config=False, description='Set whether the neighbor is notified.', default='false', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, units=None, exts=[], builtin_type='boolean', default=None))
    ])
])

