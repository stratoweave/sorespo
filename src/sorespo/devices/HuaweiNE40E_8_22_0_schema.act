    DList(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='af', key=['type'], config=True, description='Configure BGP address family instance. In public network instances, all types of address families can be configured. In IPv4 VPN instances, the IPv4 unicast, IPv4 flow, and IPv4 labeled unicast address families can be configured. In IPv6 VPN instances, the IPv6 unicast and IPv6 flow address families can be configured. The IPv4 address family in the BGP _public_ VPN instance cannot be deleted.', min_elements=0, ordered_by='system', exts=[
            DExt(module='huawei-extension', namespace='urn:huawei:yang:huawei-extension', prefix='ext', name='generated-by', arg='system', exts=[DExt(module='huawei-extension', namespace='urn:huawei:yang:huawei-extension', prefix='ext', name='filter', arg="type = 'ipv4uni'", exts=[])])
        ], children=[
        DLeaf(module='huawei-bgp', namespace='urn:huawei:yang:huawei-bgp', prefix='bgp', name='type', config=True, description='Address family type of a BGP instance.', is_key=True, mandatory=False, type=DTypeEnum(name='bgp:af-type', description='The type of bgpcommPrefix.', reference=None, units=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'ipv4uni':1, 'ipv4multi':2, 'ipv4vpn':3, 'ipv4labeluni':4, 'ipv6uni':5, 'ipv6vpn':6, 'ipv4flow':7, 'l2vpnad':8, 'evpn':9, 'mvpn':10, 'vpntarget':11, 'ipv4vpnmcast':12, 'ls':13, 'mdt':14, 'ipv6flow':15, 'mvpnv6':16, 'vpnv4flow':17, 'vpnv6flow':18, 'rpd':19, 'ipv4srpolicy':20, 'ipv6srpolicy':21, 'ipv4sdwan':22}))
