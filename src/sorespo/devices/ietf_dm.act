    DLeafList(module='ietf-isis', namespace='urn:ietf:params:xml:ns:yang:ietf-isis', prefix='isis', name='area-address', config=True, description='List of areas supported by the protocol instance.', min_elements=0, ordered_by='system', type=DTypeString(name='area-address', description='This type defines the area address format.', reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='[0-9A-Fa-f]{{2}}(\\.[0-9A-Fa-f]{{4}}){{0,6}}', pcre='^([0-9A-Fa-f]{{2}}(\\.[0-9A-Fa-f]{{4}}){{0,6}})$', invert=False)])),
