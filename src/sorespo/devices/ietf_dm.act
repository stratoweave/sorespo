one, exts=[], builtin_type='string', default=None, length=None, patterns=[]))])),
    DLeaf(module='ietf-bgp', namespace='urn:ietf:params:xml:ns:yang:ietf-bgp', prefix='bgp', name='passive-mode', config=True, description='Wait for peers to issue requests to open a BGP session,\nrather than initiating sessions from the local router.', default='false', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, exts=[], builtin_type='boolean', default=None)),
    DContainer(module='ietf-bgp', namespace='urn:ietf:params:xml:ns:yang:ietf-bgp', prefix='bgp', name='secure-session', config=True, description='Container for describing how a particular BGP session\nis to be secured.', must=[
