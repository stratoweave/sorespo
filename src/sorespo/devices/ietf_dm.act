SRC_DNODE_CHILD_0: DContainer = DContainer(module='ietf-interfaces', namespace='urn:ietf:params:xml:ns:yang:ietf-interfaces', prefix='if', name='interfaces', config=True, description='Interface parameters.', presence=False, children=[
    DList(module='ietf-interfaces', namespace='urn:ietf:params:xml:ns:yang:ietf-interfaces', prefix='if', name='interface', key=['name'], config=True, description='The list of interfaces on the device.\n\nThe status of an interface is available in this list in the\noperational state.  If the configuration of a\nsystem-controlled interface cannot be used by the system\n(e.g., the interface hardware present does not match the\ninterface type), then the configuration is not applied to\nthe system-controlled interface shown in the operational\nstate.  If the configuration of a user-controlled interface\ncannot be used by the system, the configured interface is\nnot instantiated in the operational state.\n\nSystem-controlled interfaces created by the system are\nalways present in this list in the operational state,\nwhether or not they are configured.', min_elements=0, ordered_by='system', children=[
        DLeaf(module='ietf-interfaces', namespace='urn:ietf:params:xml:ns:yang:ietf-interfaces', prefix='if', name='name', config=True, description="The name of the interface.\n\nA device MAY restrict the allowed values for this leaf,\npossibly depending on the type of the interface.\nFor system-controlled interfaces, this leaf is the\ndevice-specific name of the interface.\n\nIf a client tries to create configuration for a\nsystem-controlled interface that is not present in the\noperational state, the server MAY reject the request if\nthe implementation does not support pre-provisioning of\ninterfaces or if the name refers to an interface that can\nnever exist in the system.  A Network Configuration\nProtocol (NETCONF) server MUST reply with an rpc-error\nwith the error-tag 'invalid-value' in this case.\n\nIf the device supports pre-provisioning of interface\nconfiguration, the 'pre-provisioning' feature is\nadvertised.\n\nIf the device allows arbitrarily named user-controlled\ninterfaces, the 'arbitrary-names' feature is advertised.\n\nWhen a configured user-controlled interface is created by\nthe system, it is instantiated with the same name in the\noperational state.\n\nA server implementation MAY map this leaf to the ifName\nMIB object.  Such an implementation needs to use some\nmechanism to handle the differences in size and characters\nallowed between this leaf and ifName.  The definition of\nsuch a mechanism is outside the scope of this document.", is_key=True, mandatory=False, reference='RFC 2863: The Interfaces Group MIB - ifName', type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DLeaf(module='ietf-interfaces', namespace='urn:ietf:params:xml:ns:yang:ietf-interfaces', prefix='if', name='description', config=True, description="A textual description of the interface.\n\nA server implementation MAY map this leaf to the ifAlias\nMIB object.  Such an implementation needs to use some\nmechanism to handle the differences in size and characters\nallowed between this leaf and ifAlias.  The definition of\nsuch a mechanism is outside the scope of this document.\n\nSince ifAlias is defined to be stored in non-volatile\nstorage, the MIB implementation MUST map ifAlias to the\nvalue of 'description' in the persistently stored\nconfiguration.", is_key=False, mandatory=False, reference='RFC 2863: The Interfaces Group MIB - ifAlias', type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DLeaf(module='ietf-interfaces', namespace='urn:ietf:params:xml:ns:yang:ietf-interfaces', prefix='if', name='type', config=True, description="The type of the interface.\n\nWhen an interface entry is created, a server MAY\ninitialize the type leaf with a valid value, e.g., if it\nis possible to derive the type from the name of the\ninterface.\n\nIf a client tries to set the type of an interface to a\nvalue that can never be used by the system, e.g., if the\ntype is not supported or if the type does not match the\nname of the interface, the server MUST reject the request.\nA NETCONF server MUST reply with an rpc-error with the\nerror-tag 'invalid-value' in this case.", is_key=False, mandatory=True, reference='RFC 2863: The Interfaces Group MIB - ifType', type=DTypeIdentityref(name='identityref', description=None, reference=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_interfaces_interface_type], identities=_identities)),
        DContainer(module='ietf-ip', namespace='urn:ietf:params:xml:ns:yang:ietf-ip', prefix='ip', name='ipv4', config=True, description='Parameters for the IPv4 address family.', presence=True, children=[
            DList(module='ietf-ip', namespace='urn:ietf:params:xml:ns:yang:ietf-ip', prefix='ip', name='address', key=['ip'], config=True, description='The list of IPv4 addresses on the interface.', min_elements=0, ordered_by='system', children=[
                DLeaf(module='ietf-ip', namespace='urn:ietf:params:xml:ns:yang:ietf-ip', prefix='ip', name='ip', config=True, description='The IPv4 address on the interface.', is_key=True, mandatory=False, type=DTypeString(name='inet:ipv4-address-no-zone', description='An IPv4 address without a zone index.  This type, derived\nfrom the type ipv4-address, may be used in situations where\nthe zone is known from the context and no zone index is\nneeded.', reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?', pcre='^((([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(%.+)?)$', invert=False), YangPattern(yang_regex='[0-9\\.]*', pcre='^([0-9\\.]*)$', invert=False)])),
                DLeaf(module='ietf-ip', namespace='urn:ietf:params:xml:ns:yang:ietf-ip', prefix='ip', name='prefix-length', config=True, description='The length of the subnet prefix.', is_key=False, mandatory=False, type=DTypeIntegerUnsigned(name='uint8', description=None, reference=None, exts=[], builtin_type='uint8', default=None, ranges=Ranges([(0, 32)])))
            ])
        ]),
        DLeaf(module='ietf-network-instance', namespace='urn:ietf:params:xml:ns:yang:ietf-network-instance', prefix='ni', name='bind-ni-name', config=True, description='Network instance to which an interface is bound.', is_key=False, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep(None, 'network-instances', []), yxpath.NodeTestStep(None, 'network-instance', []), yxpath.NodeTestStep(None, 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]))),
        DContainer(module='ietf-if-extensions', namespace='urn:ietf:params:xml:ns:yang:ietf-if-extensions', prefix='if-ext', name='encapsulation', config=True, description='Holds the OSI layer 2 encapsulation associated with an\ninterface.', presence=False, when="derived-from-or-self(../if:type,\n                     'ianaift:ethernetCsmacd') or\nderived-from-or-self(../if:type,\n                     'ianaift:ieee8023adLag') or\nderived-from-or-self(../if:type, 'ianaift:pos') or\nderived-from-or-self(../if:type,\n                     'ianaift:atmSubInterface') or\nderived-from-or-self(../if:type, 'ianaift:l2vlan')", children=[
            DContainer(module='ietf-if-vlan-encapsulation', namespace='urn:ietf:params:xml:ns:yang:ietf-if-vlan-encapsulation', prefix='if-vlan', name='dot1q-vlan', config=True, description='Classifies 802.1Q VLAN tagged Ethernet frames to a\nsub-interface (or interface) by exactly matching the\nnumber of tags, tag type(s) and VLAN identifier(s).\n\nOnly frames matching the classification configured on a\nsub-interface/interface are processed on that\nsub-interface/interface.\n\nFrames that do not match any sub-interface are processed\ndirectly on the parent interface, if it is associated with\na forwarding instance, otherwise they are dropped.', presence=False, children=[
                DContainer(module='ietf-if-vlan-encapsulation', namespace='urn:ietf:params:xml:ns:yang:ietf-if-vlan-encapsulation', prefix='if-vlan', name='outer-tag', config=True, description='Specifies the VLAN tag values to match against the\noutermost (first) 802.1Q VLAN tag in the frame.', must=[
DMust(condition='tag-type = "dot1q-types:s-vlan" or tag-type = "dot1q-types:c-vlan"', description='For IEEE 802.1Q interoperability, only C-VLAN and\nS-VLAN tags are matched.', error_app_tag=None, error_message='Only Customer VLAN (C-VLAN) and Service VLAN (S-VLAN)\ntags can be matched.', reference=None)
                    ], presence=False, children=[
                    DLeaf(module='ietf-if-vlan-encapsulation', namespace='urn:ietf:params:xml:ns:yang:ietf-if-vlan-encapsulation', prefix='if-vlan', name='tag-type', config=True, description='VLAN type', is_key=False, mandatory=True, type=DTypeIdentityref(name='dot1q-types:dot1q-tag-type', description='Identifies a specific 802.1Q tag type', reference='9.5 IEEE Std 802.1Q', exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ieee802_dot1q_types_dot1q_vlan_type], identities=_identities)),
                    DLeaf(module='ietf-if-vlan-encapsulation', namespace='urn:ietf:params:xml:ns:yang:ietf-if-vlan-encapsulation', prefix='if-vlan', name='vlan-id', config=True, description='VLAN ID', is_key=False, mandatory=True, type=DTypeIntegerUnsigned(name='dot1q-types:vlanid', description='The vlanid type uniquely identifies a VLAN. This is the 12-bit\nVLAN-ID used in the VLAN Tag header. The range is defined by the\nreferenced specification. This type is in the value set and its\nsemantics equivalent to the VlanId textual convention of the SMIv2.', reference=None, exts=[], builtin_type='uint16', default=None, ranges=Ranges([(1, 4094)])))
                ])
            ])
        ]),
        DLeaf(module='ietf-if-extensions', namespace='urn:ietf:params:xml:ns:yang:ietf-if-extensions', prefix='if-ext', name='parent-interface', config=True, description='This is the reference to the parent interface of this\nsub-interface.', is_key=False, mandatory=True, reference='RFC XXXX, Section 2.6 Sub-interface', type=DTypeLeafref(name='if:interface-ref', description='This type is used by data models that need to reference\ninterfaces.', reference=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('if', 'interfaces', []), yxpath.NodeTestStep('if', 'interface', []), yxpath.NodeTestStep('if', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])))
    ])
])

SRC_DNODE_CHILD_1: DContainer = DContainer(module='ietf-network-instance', namespace='urn:ietf:params:xml:ns:yang:ietf-network-instance', prefix='ni', name='network-instances', config=True, description='Network instances, each of which consists of\nVRFs and/or VSIs.', presence=False, reference='RFC 8349: A YANG Data Model for Routing Management', children=[
    DList(module='ietf-network-instance', namespace='urn:ietf:params:xml:ns:yang:ietf-network-instance', prefix='ni', name='network-instance', key=['name'], config=True, description='List of network instances.', min_elements=0, ordered_by='system', children=[
        DLeaf(module='ietf-network-instance', namespace='urn:ietf:params:xml:ns:yang:ietf-network-instance', prefix='ni', name='name', config=True, description='device-scoped identifier for the network\ninstance.', is_key=True, mandatory=True, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DContainer(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='vpn', config=True, description="Device-level VPN attributes for a non-mounted L3VPN VRF.\nThis container selects the network instance's root type.\nBGP protocols remain in /routing and use this network\ninstance's name as their protocol instance name.", presence=True, children=[
            DLeaf(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='route-distinguisher', config=True, description='Route distinguisher assigned to this VRF.', is_key=False, mandatory=False, type=DTypeString(name='rt-types:route-distinguisher', description='A route distinguisher is an 8-octet value used to\ndistinguish routes from different BGP VPNs (RFC 4364).\nAs per RFC 4360, a route distinguisher will have the same\nformat as a route target and will consist of two or three\nfields including a 2-octet type field, an administrator\nfield, and, optionally, an assigned number field.\n\nAccording to the data formats for type 0, 1, 2, and 6\ndefined in RFC4360, RFC5668, and RFC7432, the encoding\npattern is defined as:\n\n0:2-octet-asn:4-octet-number\n1:4-octet-ipv4addr:2-octet-number\n2:4-octet-asn:2-octet-number.\n6:6-octet-mac-address.\n\nAdditionally, a generic pattern is defined for future\nroute discriminator types:\n\n2-octet-other-hex-number:6-octet-hex-number\n\nSome valid examples are: 0:100:100, 1:1.1.1.1:100,\n2:1234567890:203 and 6:26:00:08:92:78:00', reference='RFC4360: BGP Extended Communities Attribute.\nRFC4364: BGP/MPLS IP Virtual Private Networks (VPNs)\nRFC5668: 4-Octet AS Specific BGP Extended Community.\nRFC7432: BGP MPLS-Based Ethernet VPN', exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}})', pcre='^((0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}}))$', invert=False)])),
            DList(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='address-family', key=['name'], config=True, description='Per-address-family VPN membership.', min_elements=0, ordered_by='system', children=[
                DLeaf(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='name', config=True, description='VPN address family.', is_key=True, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'ipv4-unicast':0, 'ipv6-unicast':1})),
                DLeafList(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='import-route-target', config=True, description='Route targets accepted by this VRF.', min_elements=0, ordered_by='system', type=DTypeString(name='rt-types:route-target', description='A route target is an 8-octet BGP extended community\ninitially identifying a set of sites in a BGP\nVPN (RFC 4364). However, it has since taken on a more\ngeneral role in BGP route filtering.\nA route target consists of two or three fields:\na 2-octet type field, an administrator field,\nand, optionally, an assigned number field.\n\nAccording to the data formats for type 0, 1, 2, and 6\ndefined in RFC4360, RFC5668, and RFC7432, the encoding\npattern is defined as:\n\n0:2-octet-asn:4-octet-number\n1:4-octet-ipv4addr:2-octet-number\n2:4-octet-asn:2-octet-number.\n6:6-octet-mac-address.\n\nAdditionally, a generic pattern is defined for future\nroute target types:\n\n2-octet-other-hex-number:6-octet-hex-number\n\nSome valid examples are: 0:100:100, 1:1.1.1.1:100,\n2:1234567890:203 and 6:26:00:08:92:78:00', reference='RFC4360: BGP Extended Communities Attribute.\nRFC4364: BGP/MPLS IP Virtual Private Networks (VPNs)\nRFC5668: 4-Octet AS Specific BGP Extended Community.\nRFC7432: BGP MPLS-Based Ethernet VPN', exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}})', pcre='^((0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}}))$', invert=False)])),
                DLeafList(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='export-route-target', config=True, description='Route targets attached to exported routes.', min_elements=0, ordered_by='system', type=DTypeString(name='rt-types:route-target', description='A route target is an 8-octet BGP extended community\ninitially identifying a set of sites in a BGP\nVPN (RFC 4364). However, it has since taken on a more\ngeneral role in BGP route filtering.\nA route target consists of two or three fields:\na 2-octet type field, an administrator field,\nand, optionally, an assigned number field.\n\nAccording to the data formats for type 0, 1, 2, and 6\ndefined in RFC4360, RFC5668, and RFC7432, the encoding\npattern is defined as:\n\n0:2-octet-asn:4-octet-number\n1:4-octet-ipv4addr:2-octet-number\n2:4-octet-asn:2-octet-number.\n6:6-octet-mac-address.\n\nAdditionally, a generic pattern is defined for future\nroute target types:\n\n2-octet-other-hex-number:6-octet-hex-number\n\nSome valid examples are: 0:100:100, 1:1.1.1.1:100,\n2:1234567890:203 and 6:26:00:08:92:78:00', reference='RFC4360: BGP Extended Communities Attribute.\nRFC4364: BGP/MPLS IP Virtual Private Networks (VPNs)\nRFC5668: 4-Octet AS Specific BGP Extended Community.\nRFC7432: BGP MPLS-Based Ethernet VPN', exts=[], builtin_type='string', default=None, length=None, patterns=[YangPattern(yang_regex='(0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}})', pcre='^((0:(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0):(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0))|(1:((([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])\\.){{3}}([0-9]|[1-9][0-9]|1[0-9]{{2}}|2[0-4][0-9]|25[0-5])):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(2:(429496729[0-5]|42949672[0-8][0-9]|4294967[01][0-9]{{2}}|429496[0-6][0-9]{{3}}|42949[0-5][0-9]{{4}}|4294[0-8][0-9]{{5}}|429[0-3][0-9]{{6}}|42[0-8][0-9]{{7}}|4[01][0-9]{{8}}|[1-3][0-9]{{9}}|[1-9][0-9]{{0,8}}|0):(6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{{2}}|6[0-4][0-9]{{3}}|[1-5][0-9]{{4}}|[1-9][0-9]{{0,3}}|0))|(6(:[a-fA-F0-9]{{2}}){{6}})|(([3-57-9a-fA-F]|[1-9a-fA-F][0-9a-fA-F]{{1,3}}):[0-9a-fA-F]{{1,12}}))$', invert=False)]))
            ]),
            DLeaf(module='stratoweave-network', namespace='https://stratoweave.org/yang/stratoweave-network', prefix='swdev', name='label-allocation', config=True, description='Explicit request for one MPLS label per VRF.', is_key=False, mandatory=False, type=DTypeEnum(name='enumeration', description=None, reference=None, exts=[], builtin_type='enumeration', default=None, name_to_val={'per-vrf':0}))
