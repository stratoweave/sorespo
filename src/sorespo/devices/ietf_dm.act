    DLeaf(module='ietf-bgp-policy', namespace='urn:ietf:params:xml:ns:yang:ietf-bgp-policy', prefix='bp', name='community-set-ref', config=True, description='References a defined community set by name', is_key=False, mandatory=False, type=DTypeLeafref(name='leafref', description=None, reference=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('rt-pol', 'routing-policy', []), yxpath.NodeTestStep('rt-pol', 'defined-sets', []), yxpath.NodeTestStep(None, 'bgp-defined-sets', []), yxpath.NodeTestStep(None, 'community-sets', []), yxpath.NodeTestStep(None, 'community-set', []), yxpath.NodeTestStep(None, 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])))
])

