SRC_DNODE_CHILD_2: DContainer = DContainer(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='key-chains', config=True, description='All configured key-chains on the device.', presence=False, children=[
    DList(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='key-chain', key=['name'], config=True, description='List of key-chains.', min_elements=0, ordered_by='system', children=[
        DLeaf(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='name', config=True, description='Name of the key-chain.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
        DList(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='key', key=['key-id'], config=True, description='Single key in key chain.', min_elements=0, ordered_by='system', children=[
            DLeaf(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='key-id', config=True, description='Numeric value uniquely identifying the key', is_key=True, mandatory=False, type=DTypeIntegerUnsigned(name='uint64', description=None, reference=None, exts=[], builtin_type='uint64', default=None, ranges=Ranges([(0, 18446744073709551615)]))),
            DLeaf(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='crypto-algorithm', config=True, description='Cryptographic algorithm associated with key.', is_key=False, mandatory=True, type=DTypeIdentityref(name='identityref', description=None, reference=None, exts=[], builtin_type='identityref', default=None, identity_bases=[_base_ietf_key_chain_crypto_algorithm], identities=_identities)),
            DContainer(module='ietf-key-chain', namespace='urn:ietf:params:xml:ns:yang:ietf-key-chain', prefix='key-chain', name='key-string', config=True, description='The key string.', presence=False, exts=[
                    DExt(module='ietf-netconf-acm', namespace='urn:ietf:params:xml:ns:yang:ietf-netconf-acm', prefix='nacm', name='default-deny-all', arg=None, exts=[])
                ], children=[
