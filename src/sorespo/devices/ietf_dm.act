            DLeaf(module='ietf-isis', namespace='urn:ietf:params:xml:ns:yang:ietf-isis', prefix='isis', name='passive', config=True, description='Indicates whether the interface is in passive mode (IS-IS\nis not running, but the network is advertised).', default='false', is_key=False, mandatory=False, type=DTypeBoolean(name='boolean', description=None, reference=None, exts=[], builtin_type='boolean', default=None)),
