                    ], type=DTypeLeafref(name='if:interface-ref', description='This type is used by data models that need to reference\ninterfaces.', reference=None, exts=[], builtin_type='leafref', default=None, path=yxpath.AbsoluteLocationPath([yxpath.NodeTestStep('if', 'interfaces', []), yxpath.NodeTestStep('if', 'interface', []), yxpath.NodeTestStep('if', 'name', [])]), require_instance=False, target_type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[]))),
                DContainer(module='ietf-mpls-ldp', namespace='urn:ietf:params:xml:ns:yang:ietf-mpls-ldp', prefix='ldp', name='address-families', config=True, description='Container for address families.', presence=False, children=[
