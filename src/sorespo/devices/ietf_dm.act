        DLeaf(module='ietf-routing-policy', namespace='urn:ietf:params:xml:ns:yang:ietf-routing-policy', prefix='rt-pol', name='name', config=True, description='Name of the prefix set -- this is used as a label to\nreference the set in match conditions.', is_key=True, mandatory=False, type=DTypeString(name='string', description=None, reference=None, exts=[], builtin_type='string', default=None, length=None, patterns=[])),
