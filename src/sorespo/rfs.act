_SRL_AES1_SALT = b"\x01\x00sorespo!\x6f"

def _is_junos(di) -> bool:
    return "http://xml.juniper.net/netconf/junos/1.0" in di.modules or "junos-conf-root" in di.modules

def _is_ios_xr(di) -> bool:
    return "Cisco-IOS-XR-um-hostname-cfg" in di.modules

def _is_srl(di) -> bool:
    return "srl_nokia-system" in di.modules

def split_interface_name(interface):
    """Split interface name into main interface and unit number.
    Example: 'ge-0/0/0.100' returns ('ge-0/0/0', '100')
    """
    parts = interface.split('.')
    if len(parts) == 2:
        return (parts[0], parts[1])
    return (interface, "0")

def net_from_ip_address(ip_address):
    """Generate a NET address from an IPv4 address."""
    # calculate the net-clns-address from IPv4 address:
    # first split the address into an array of padded strings
    # 123.45.67.8 => ['123', '045', '067', '008'],
    # then join to form a long string '123045067008'
    # and split the long string into '1230.4506.7008' to be used in the final net_clns_address
    padded_split = ["%03d" % int(v) for v in ip_address.split('.')]
    join_str = ''.join(padded_split)
    net_clns_address = '49.0001.' + join_str[0:4] + '.' + join_str[4:8] + '.' + join_str[8:] + '.00'
    return net_clns_address

def _bb_interface_description(remote_device: str, remote_interface: str) -> str:
    return "Link to {remote_device} [{remote_interface}]"

def bb_interface_subscription_owner_id(interface_name: str) -> str:
    return "backbone-interface:{interface_name}"

# --- BGP neighbor session telemetry (SR Linux) -------------------------------
# Poll SR Linux BGP session-state normally; subscribe to details only in debug.

class BgpNeighborStats(object):
    session_state: ?str
    last_event: ?str
    established_transitions: ?u64
    negotiated_hold_time: ?u64
    last_notification: ?str

    def __init__(self):
        self.session_state = None
        self.last_event = None
        self.established_transitions = None
        self.negotiated_hold_time = None
        self.last_notification = None

def _fmt_notification(sent: ?str, received: ?str) -> ?str:
    # Tag notification direction so local and peer teardowns stay distinct.
    if sent is not None and received is not None:
        return "sent:{sent} received:{received}"
    if sent is not None:
        return "sent:{sent}"
    if received is not None:
        return "received:{received}"
    return None

def _read_srl_bgp(root: srl25_oper_root, ni: str, addr: str) -> BgpNeighborStats:
    s = BgpNeighborStats()
    for n in root.network_instance:
        if n.name == ni:
            bgp = n.protocols.bgp
            if bgp is not None:
                for nb in bgp.neighbor:
                    if nb.peer_address == addr:
                        s.session_state = nb.session_state
                        s.last_event = nb.last_event
                        s.established_transitions = nb.established_transitions
                        s.negotiated_hold_time = nb.timers.negotiated_hold_time
                        s.last_notification = _fmt_notification(nb.sent_messages.last_notification_error_code, nb.received_messages.last_notification_error_code)
    return s

# --- BGP neighbor session telemetry (Cisco IOS XR) ---------------------------
# XR exposes neighbor oper state under Cisco-IOS-XR-ipv4-bgp-oper; the eBGP
# customer neighbor lives in the per-VRF table (vrfs/vrf), matching the RFS
# ebgp-customer config which places it under `router bgp <as> / vrf <name>`.

def _xr_conn_state(s: ?str) -> ?str:
    # Normalise XR Bgp-conn-state ("bgp-st-estab", …) to the layer's session-state
    # enum. Anything other than "established" keeps debug escalation armed.
    if s is None:
        return None
    elif s == "bgp-st-idle":
        return "idle"
    elif s == "bgp-st-connect":
        return "connect"
    elif s == "bgp-st-active":
        return "active"
    elif s == "bgp-st-open-sent":
        return "opensent"
    elif s == "bgp-st-open-confirm":
        return "openconfirm"
    elif s == "bgp-st-estab":
        return "established"
    else:
        # closing / closing-sync / dont-care: not established.
        return "idle"

def _xr_reset_reason(r: ?str) -> ?str:
    # "bgp-none" means the session has never reset; treat as no event.
    if r is None or r == "bgp-none":
        return None
    return r

def _fmt_xr_notification(code: ?u64, subcode: ?u64) -> ?str:
    # XR reports the last NOTIFICATION as numeric code/subcode; surface only real ones.
    if code is not None and code != 0:
        sc = subcode if subcode is not None else u64(0)
        return "code:{code} subcode:{sc}"
    return None

def _read_xr_bgp(root: xr25_oper_root, vrf: str, addr: str) -> BgpNeighborStats:
    s = BgpNeighborStats()
    for inst in root.bgp.instances.instance:
        for v in inst.instance_active.vrfs.vrf:
            if v.vrf_name == vrf:
                for nb in v.neighbors.neighbor:
                    if nb.neighbor_address == addr:
                        s.session_state = _xr_conn_state(nb.connection_state)
                        s.negotiated_hold_time = nb.hold_time
                        s.last_event = _xr_reset_reason(nb.reset_reason)
                        s.last_notification = _fmt_xr_notification(nb.last_notify_error_code, nb.last_notify_error_subcode)
    return s

class BaseConfig(base.BaseConfig):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/base-config transform running {i.role}", err=True)
        is_cisco_xr = _is_ios_xr(di)
        is_junos = _is_junos(di)
        is_srl = _is_srl(di)

        net_clns_address = net_from_ip_address(i.ipv4_address)

        if is_cisco_xr or is_junos:
            print("RFS /rfs{{{di.name}}}/base-config transform running {i.role} for IETF Device Model", err=True)
            ietf = ietf_dm.root()
            ietf.system.hostname = di.name
            loopback = ietf.interfaces.interface.create("Loopback0", type=ietf_dm.iana_if_type_softwareLoopback)
            loopback.create_ipv4().address.create(i.ipv4_address, prefix_length=32)

            # Create the ISIS instance for the device
            isis = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_isis_isis, "1")).isis
            isis.level_type = "level-2"
            isis.system_id = ".".join(net_clns_address.split(".")[2:5])
            isis.area_address.append("49.0001")
            isis.metric_type.value = "wide-only"
            isis.interfaces.interface.create("Loopback0", passive=True)

            # Create the BGP instance for the device
            bgp = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_bgp_bgp, "default")).bgp
            bgp.create_global(as_=i.asn)
            group = bgp.peer_groups.peer_group.create("IPV4-IBGP", peer_as=i.asn)
            group.transport.local_address = "Loopback0"
            group.transport.secure_session.enabled = True
            key = ietf.key_chains.key_chain.create("ibgp").key.create(1, crypto_algorithm=ietf_dm.ietf_key_chain_md5)
            key.key_string.keystring = i.ibgp_authentication_key
            group.transport.secure_session.options.md5_keychain = "ibgp"
            for family in [ietf_dm.iana_bgp_afi_safi_types_l3vpn_ipv4_unicast, ietf_dm.iana_bgp_afi_safi_types_l3vpn_ipv6_unicast]:
                group.afi_safis.afi_safi.create(family, enabled=True)
                if not is_junos:
                    bgp.create_global().afi_safis.afi_safi.create(family, enabled=True)

            if is_cisco_xr:
                bgp.create_global().identifier = i.ipv4_address
                ietf.routing_policy.policy_definitions.policy_definition.create("ACCEPT").statements.statement.create("accept").actions.policy_result = "accept-route"

            if is_junos:
                loopback.description = "ROLE: {i.role}"
                isis.lsp_lifetime = 65535
                group.timers.hold_time = 90
                group.logging_options.log_neighbor_state_changes = True
                group.afi_safis.afi_safi.create(ietf_dm.stratoweave_network_route_target_constraints, enabled=True)

            return ietf

        elif is_srl:
            print("RFS /rfs{{{di.name}}}/base-config transform for Nokia SRLinux", err=True)
            dev = srl25.root()
            device_name = di.name
            dev.system.name.host_name = device_name
            index = dev.interface.create("system0").subinterface.create(0)
            index.ipv4.admin_state = "enable"
            index.ipv4.address.create("{i.ipv4_address}/32")

            intf_mgmt = dev.interface.create("mgmt0", admin_state="enable")
            intf_mgmt0 = intf_mgmt.subinterface.create(0, admin_state="enable")
            intf_mgmt0.ipv4.admin_state = "enable"
            intf_mgmt0.ipv6.admin_state = "enable"

            # mgmt network-instance is required
            ni_mgmt = dev.network_instance.create("mgmt", type=srl25.srl_nokia_network_instance_ip_vrf, admin_state="enable", description="Management network instance")
            ni_mgmt.interface.create("mgmt0.0")

            # IS-IS global config
            ni = dev.network_instance.create("default")
            ni.interface.create("system0.0")
            isis = ni.protocols.create_isis()
            instance = isis.instance.create("quicklab", level_capability="L2", admin_state="enable")
            instance.net = [ net_clns_address ]
            instance.ipv4_unicast.admin_state = "enable"
            instance.interface.create("system0.0", admin_state="enable", passive=True)

            # BGP global config
            bgp = ni.protocols.create_bgp(autonomous_system=i.asn, router_id=i.ipv4_address)
            bgp.afi_safi.create(srl25.srl_nokia_common_ipv4_unicast, admin_state="enable")
            bgp.afi_safi.create(srl25.srl_nokia_common_evpn, admin_state="enable")

            # Create neighbor-group: IPV4-IBGP
            bgp.group.create("IPV4-IBGP", peer_as=i.asn)

            return dev

        raise UnsupportedDevice()

class BBInterface(base.BBInterface):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/backbone-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}]", err=True)
        is_cisco = _is_ios_xr(di)
        is_junos = _is_junos(di)
        is_srl = _is_srl(di)
        if_description = _bb_interface_description(i.remote.device, i.remote.interface)

        if is_cisco or is_junos:
            print("RFS /rfs{{{di.name}}}/backbone-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for IETF Device Model", err=True)
            ietf = ietf_dm.root()

            # Create the interface and configure basic settings
            interface = ietf.interfaces.interface.create(i.name, description=if_description, type=ietf_dm.iana_if_type_ethernetCsmacd)
            if i.ipv4_address is not None:
                interface.create_ipv4().address.create(i.ipv4_address!, prefix_length=i.ipv4_prefix_length)

            # Configure IS-IS
            isis = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_isis_isis, "1")).isis
            ci = isis.interfaces.interface.create(i.name, level_type="level-2", interface_type="point-to-point")
            ci.metric.level_2.value = 5000

            # Configure MPLS and LDP
            ietf.routing.mpls.interfaces.interface.create(i.name, mpls_enabled=True)
            ldp = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_mpls_ldp_mpls_ldp, "ldp")).mpls_ldp
            ldp.global.address_families.create_ipv4(enabled=True)
            ldp.discovery.interfaces.interface.create(i.name).address_families.create_ipv4(enabled=True)
            
            return ietf

        elif is_srl:
            print("RFS /rfs{{{di.name}}}/backbone-interface transform running [{i.name}] <-> {i.remote.device} [{i.remote.interface}] for Nokia SRLinux", err=True)
            dev = srl25.root()

            # Create the interface
            ni = dev.network_instance.create("default")
            intf = dev.interface.create(i.name)
            intf.description = if_description
            intf.admin_state = "enable"
            subif = intf.subinterface.create(0)
            subif.admin_state = "enable"
            subif.description = if_description
            subif.ipv4.admin_state = "enable"
            ipv4_address = i.ipv4_address
            if ipv4_address is not None:
                subif.ipv4.address.create("%s/%s" % (ipv4_address, str(i.ipv4_prefix_length)))

            # Add interface to network-instance
            ni.interface.create("%s.0" % i.name)

            # IS-IS config for this interface
            isis = ni.protocols.create_isis()
            instance = isis.instance.create("quicklab")
            isis_intf = instance.interface.create("%s.0" % i.name)
            isis_intf.admin_state = "enable"
            isis_intf.circuit_type = "point-to-point"
            il2 = isis_intf.level.create(2)
            il2.metric = 5000

            return dev

        raise UnsupportedDevice()


# --- Backbone interface oper-status -------------------------------------------
# Poll each backbone interface's oper-state from the device. The inter/CFS
# BBLinkTransform lift combines the two endpoints into a link-status (up only
# when both ends are up). SR Linux and IOS XR expose interface oper-state.
actor BBInterfaceTransform(path, update_oper: proc(?y_2_oper.stratoweave_rfs__rfs__backbone_interface_entry)->None, dev: swdev.DeviceMgr):
    _subs = gdata.SubscriptionManager(dev.tree_provider(), str(path))
    _oper = base.BBInterface.new_state(path)

    def publish(oper_status: ?str):
        _oper.state.oper_status = oper_status
        update_oper(_oper)

    def on_xr_state(root: ?xr25_oper_root, err: ?Exception):
        status: ?str = None
        if err is not None:
            print("BBInterfaceTransform subscription error: {err}", err=True)
        elif root is not None:
            for interface in root.pfi_im_cmd_oper_interfaces.interface_xr.interface:
                raw = interface.state
                if raw == "im-state-up" or raw == "im-state-operational":
                    status = "up"
                elif raw == "im-state-unknown" or raw == "im-state-not-ready" or raw == "im-state-last":
                    status = "unknown"
                elif raw is not None and raw.startswith("im-state-"):
                    # Any other im-state-* (admin/non-admin down, shutdown,
                    # err-disable, transitions, reset, …) is operationally down.
                    status = "down"
                elif raw is not None:
                    status = "unknown"
        publish(status)

    def on_srl_state(root: ?srl25_oper_root, err: ?Exception):
        status: ?str = None
        if err is not None:
            print("BBInterfaceTransform subscription error: {err}", err=True)
        elif root is not None:
            for interface in root.interface:
                raw = interface.oper_state
                if raw == "up":
                    status = "up"
                elif raw == "down":
                    status = "down"
                elif raw is not None:
                    status = "unknown"
        publish(status)

    def on_conf(conf: y_2.stratoweave_rfs__rfs__backbone_interface_entry):
        want: set[gdata.Delivery] = set()
        modset = dev.get_modules().0
        if "Cisco-IOS-XR-um-hostname-cfg" in modset:
            xr_dst = xr25_oper.dst(on_xr_state)
            want.add(xr_dst.deliver({
                xr25_oper.subs.pfi_im_cmd_oper_interfaces.interface_xr.interface.entry(conf.name).state.subscribe(period=5.0)
            }))
        elif "srl_nokia-system" in modset:
            srl_dst = srl25_oper.dst(on_srl_state)
            want.add(srl_dst.deliver({
                srl25_oper.subs.interface.entry(conf.name).oper_state.subscribe(period=5.0)
            }))
        _subs.declare(want)

    def shutdown():
        pass


class IbgpNeighbor(base.IbgpNeighbor):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/ibgp-neighbor transform running {i.address}", err=True)

        if _is_ios_xr(di) or _is_junos(di):
            print("RFS /rfs{{{di.name}}}/ibgp-neighbor transform running {i.address} for IETF Device Model", err=True)
            ietf = ietf_dm.root()
            bgp = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_bgp_bgp, "default")).bgp
            bgp.create_global(as_=i.asn)
            bgp.neighbors.neighbor.create(i.address, remote_address=i.address, description=i.description, peer_group="IPV4-IBGP")
            return ietf

        elif _is_srl(di):
            print("RFS /rfs{{{di.name}}}/ibgp-neighbor transform running {i.address} for Nokia SRLinux", err=True)
            dev = srl25.root()
            bgp = dev.network_instance.create("default").protocols.create_bgp()
            bgp.group.create("IPV4-IBGP")
            n = bgp.neighbor.create(i.address, peer_group="IPV4-IBGP", admin_state="enable", description=i.description)
            if i.ibgp_authentication_key is not None:
                n.authentication.password = nokia_srl_aes1_encrypt(i.ibgp_authentication_key!, _SRL_AES1_SALT)
            return dev

        raise UnsupportedDevice()


class Vrf(base.Vrf):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/vrf transform running {i.name}", err=True)
        is_ios_xr = _is_ios_xr(di)
        is_junos = _is_junos(di)

        route_distinguisher_id = "{i.id}{i.router_id}"
        if is_ios_xr or is_junos:
            print("RFS /rfs{{{di.name}}}/vrf transform running {i.name} for IETF Device Model", err=True)

            ietf = ietf_dm.root()

            # Create the network instance for the VRF
            instance = ietf.network_instances.network_instance.create(i.name)
            vpn = instance.create_vpn(route_distinguisher="0:{i.asn}:{route_distinguisher_id}")
            af = vpn.address_family.create("ipv4-unicast")
            af.import_route_target.append("0:{i.asn}:{i.id}")
            af.export_route_target.append("0:{i.asn}:{i.id}")
            if is_junos:
                vpn.label_allocation = "per-vrf"

            # Configure BGP for the VRF
            bgp = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_bgp_bgp, i.name)).bgp
            bgp.create_global(as_=i.asn)
            group = bgp.peer_groups.peer_group.create("customer")
            if is_junos:
                group.transport.passive_mode = True

            return ietf

        elif _is_srl(di):
            print("RFS /rfs{{{di.name}}}/vrf transform running {i.name} for Nokia SRLinux", err=True)
            dev = srl25.root()

            # Create the VRF
            ni = dev.network_instance.create(i.name, type=srl25.srl_nokia_network_instance_ip_vrf, admin_state="enable")

            # VXLAN interface
            tunnel_if = dev.tunnel_interface.create("vxlan1")
            vxlan_if = tunnel_if.vxlan_interface.create(i.id)
            vxlan_if.type = srl25.srl_nokia_interfaces_routed
            vxlan_if.ingress.vni = i.id
            vxlan_if_name = "vxlan1.{i.id}"
            ni.vxlan_interface.create(vxlan_if_name)

            # BGP-VPN protocol
            bgp_vpn = ni.protocols.create_bgp_vpn()
            bgp_vpn_instance = bgp_vpn.bgp_instance.create(1)
            bgp_vpn_instance.route_target.export_rt = "target:{i.asn}:{i.id}"
            bgp_vpn_instance.route_target.import_rt = "target:{i.asn}:{i.id}"

            # BGP-EVPN protocol
            bgp_evpn = ni.protocols.create_bgp_evpn()
            bgp_evpn.bgp_instance.create(1, admin_state="enable", vxlan_interface=vxlan_if_name, evi=i.id)

            # BGP protocol
            bgp = ni.protocols.create_bgp(router_id="10.0.0.{i.router_id}", autonomous_system=i.asn)
            bgp.ebgp_default_policy.import_reject_all = False
            bgp.ebgp_default_policy.export_reject_all = False
            bgp.afi_safi.create(srl25.srl_nokia_common_ipv4_unicast, admin_state="enable")
            group = bgp.group.create("customer")
            group.send_default_route.ipv4_unicast = True

            return dev

        raise UnsupportedDevice()


class VrfInterface(base.VrfInterface):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/vrf-interface transform running {i.name}", err=True)
        # TODO: input validation to ensure this is a subinterface with VLAN ID
        # Split interface name into main interface and unit
        main_intf, vlan_id = split_interface_name(i.name)

        if _is_ios_xr(di) or _is_junos(di):
            print("RFS /rfs{{{di.name}}}/vrf-interface transform running {i.name} for IETF Device Model", err=True)
            ietf = ietf_dm.root()

            # Create the main interface for the VRF
            ietf.interfaces.interface.create(main_intf, description="Customer access port", type=ietf_dm.iana_if_type_ethernetCsmacd)

            # Create the subinterface for the VRF
            interface = ietf.interfaces.interface.create(i.name, description=i.description,
                type=ietf_dm.iana_if_type_l2vlan, parent_interface=main_intf, bind_ni_name=i.vrf)
            tag = interface.encapsulation.dot1q_vlan.outer_tag
            tag.tag_type = ietf_dm.ieee802_dot1q_types_c_vlan
            tag.vlan_id = u64(vlan_id)
            if i.ipv4_address is not None:
                interface.create_ipv4().address.create(i.ipv4_address!, prefix_length=i.ipv4_prefix_length)
            
            return ietf

        elif _is_srl(di):
            print("RFS /rfs{{{di.name}}}/vrf-interface transform running {i.name} for Nokia SRLinux", err=True)
            dev = srl25.root()

            # Create the main interface
            intf = dev.interface.create(main_intf, admin_state="enable", vlan_tagging=True)

            # Create the subinterface
            subif = intf.subinterface.create(u64(vlan_id), description=i.description, admin_state="enable")
            subif.vlan.encap.create_single_tagged().vlan_id = int(vlan_id)

            # Configure IPv4 address if present
            ipv4_address = i.ipv4_address
            if ipv4_address is not None:
                subif.ipv4.admin_state = "enable"
                subif.ipv4.address.create("%s/%s" % (ipv4_address, str(i.ipv4_prefix_length)))

            # Add interface to the correct network-instance (VRF)
            ni = dev.network_instance.create(i.vrf)
            ni.interface.create("%s.%s" % (main_intf, vlan_id))

            return dev

        raise UnsupportedDevice()

class EbgpCustomer(base.EbgpCustomer):
    def transform(self, i, di):
        print("RFS /rfs{{{di.name}}}/ebgp-customer transform running {i.address}", err=True)
        is_ios_xr = _is_ios_xr(di)
        is_junos = _is_junos(di)

        if is_ios_xr or is_junos:
            ietf = ietf_dm.root()

            # Create the ACCEPT policy for BGP peers
            ietf.routing_policy.policy_definitions.policy_definition.create("ACCEPT").statements.statement.create("accept").actions.policy_result = "accept-route"


            # Create the BGP instance for the VRF
            bgp = ietf.routing.control_plane_protocols.control_plane_protocol.create((ietf_dm.ietf_bgp_bgp, i.vrf)).bgp
            bgp.create_global(as_=i.local_asn).afi_safis.afi_safi.create(ietf_dm.iana_bgp_afi_safi_types_ipv4_unicast, enabled=True)
            
            # Create the BGP neighbor for the VRF
            peer = bgp.neighbors.neighbor.create(i.address, remote_address=i.address,
                peer_as=i.peer_asn, description=i.description, peer_group="customer")
            peer.as_path_options.replace_peer_as = True
            peer.timers.hold_time = 3
            af = peer.afi_safis.afi_safi.create(ietf_dm.iana_bgp_afi_safi_types_ipv4_unicast, enabled=True)
            af.apply_policy.import_policy.append("ACCEPT")
            if is_ios_xr:
                af.apply_policy.export_policy.append("ACCEPT")
                peer.timers.keepalive = 1

            # BGP neighbor authentication configuration
            if i.authentication_key is not None:
                peer.transport.secure_session.enabled = True
                keychain_name = "ebgp:{i.vrf}:{i.address}"
                key = ietf.key_chains.key_chain.create(keychain_name).key.create(1, crypto_algorithm=ietf_dm.ietf_key_chain_md5)
                key.key_string.keystring = i.authentication_key!
                peer.transport.secure_session.options.md5_keychain = keychain_name
            return ietf

        elif _is_srl(di):
            print("RFS /rfs{{{di.name}}}/ebgp-customer transform running {i.address} for Nokia SRLinux", err=True)
            dev = srl25.root()
            ni = dev.network_instance.create(i.vrf)

            # Neighbor config
            bgp = ni.protocols.create_bgp()
            neighbor = bgp.neighbor.create(i.address, peer_as=i.peer_asn, peer_group="customer")
            if i.authentication_key is not None:
                neighbor.authentication.password = nokia_srl_aes1_encrypt(i.authentication_key!, _SRL_AES1_SALT)
            neighbor.timers.connect_retry = 3
            neighbor.timers.hold_time = 3
            neighbor.timers.keepalive_interval = 1

            return dev

        raise UnsupportedDevice()


actor EbgpCustomerTransform(path, update_oper: proc(?y_2_oper.stratoweave_rfs__rfs__ebgp_customer_entry)->None, dev: swdev.DeviceMgr):
    # eBGP customer neighbor: a single-hop PE<->CE peer in the VRF network-instance.
    _subs = gdata.SubscriptionManager(dev.tree_provider(), str(path))
    _oper = base.EbgpCustomer.new_state(path)
    var debug: bool = False
    var _addr: ?str = None
    var _vrf: ?str = None

    def declare():
        want: set[gdata.Delivery] = set()
        modset = dev.get_modules().0
        addr = _addr
        vrf = _vrf
        if addr is not None and vrf is not None and "srl_nokia-system" in modset:
            dst = srl25_oper.dst(on_srl_state)
            nb = srl25_oper.subs.network_instance.entry(vrf).protocols.bgp.neighbor.entry(addr)
            period = 1.0 if debug else 2.0
            specs: set[gdata.SubscriptionSpec] = { nb.session_state.subscribe(period=period) }
            if debug:
                specs.add(nb.last_event.subscribe(period=1.0))
                specs.add(nb.established_transitions.subscribe(period=1.0))
                specs.add(nb.timers.negotiated_hold_time.subscribe(period=1.0))
                specs.add(nb.received_messages.last_notification_error_code.subscribe(period=1.0))
                specs.add(nb.sent_messages.last_notification_error_code.subscribe(period=1.0))
            want.add(dst.deliver(specs))
        elif addr is not None and vrf is not None and "Cisco-IOS-XR-um-hostname-cfg" in modset:
            dst = xr25_oper.dst(on_xr_state)
            nb = xr25_oper.subs.bgp.instances.instance.entry("default").instance_active.vrfs.vrf.entry(vrf).neighbors.neighbor.entry(addr)
            period = 1.0 if debug else 2.0
            specs: set[gdata.SubscriptionSpec] = { nb.connection_state.subscribe(period=period) }
            if debug:
                specs.add(nb.reset_reason.subscribe(period=1.0))
                specs.add(nb.hold_time.subscribe(period=1.0))
                specs.add(nb.last_notify_error_code.subscribe(period=1.0))
                specs.add(nb.last_notify_error_subcode.subscribe(period=1.0))
            want.add(dst.deliver(specs))
        _subs.declare(want)

    def on_srl_state(root: ?srl25_oper_root, err: ?Exception):
        if err is not None:
            print("EbgpCustomerTransform subscription error: {err}", err=True)
            return
        addr = _addr
        vrf = _vrf
        s = BgpNeighborStats()
        if root is not None and addr is not None and vrf is not None:
            s = _read_srl_bgp(root, vrf, addr)
        publish(s)

    def on_xr_state(root: ?xr25_oper_root, err: ?Exception):
        if err is not None:
            print("EbgpCustomerTransform subscription error: {err}", err=True)
            return
        addr = _addr
        vrf = _vrf
        s = BgpNeighborStats()
        if root is not None and addr is not None and vrf is not None:
            s = _read_xr_bgp(root, vrf, addr)
        publish(s)

    def publish(s: BgpNeighborStats):
        # Deliveries may contain only changed leaves; keep prior values when absent.
        if s.session_state is not None:
            _oper.state.session_state = s.session_state
        ss = _oper.state.session_state
        new_debug = ss is not None and ss != "established"
        if new_debug:
            # Fold in whatever detail this delivery carried.
            if s.last_event is not None:
                _oper.state.last_event = s.last_event
            if s.established_transitions is not None:
                _oper.state.established_transitions = s.established_transitions
            if s.negotiated_hold_time is not None:
                _oper.state.negotiated_hold_time = s.negotiated_hold_time
            if s.last_notification is not None:
                _oper.state.last_notification = s.last_notification
        else:
            # Clear details outside debug.
            _oper.state.last_event = None
            _oper.state.established_transitions = None
            _oper.state.negotiated_hold_time = None
            _oper.state.last_notification = None
        _oper.state.debug_active = new_debug
        if new_debug != debug:
            debug = new_debug
            declare()
        update_oper(_oper)

    def on_conf(conf: y_2.stratoweave_rfs__rfs__ebgp_customer_entry):
        _addr = conf.address
        _vrf = conf.vrf
        declare()

    def shutdown():
        pass
