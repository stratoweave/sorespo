"""IETF system, policy, and network configuration to ArcOS 8.2.1."""
import sorespo.devices.ietf_dm as ietf_dm
import sorespo.devices.ArcOS_8_2_1 as arcos8
from yang.identityref import Identityref
from sorespo.devices.ietf_dm import ietf_interfaces__interfaces__interface_entry as Interface
from sorespo.devices.ietf_dm import ietf_network_instance__network_instances__network_instance_entry as NetworkInstance
from sorespo.devices.ietf_dm import ietf_routing__routing__mpls__interfaces__interface_entry as MplsInterface
from sorespo.devices.ietf_dm import ietf_routing__routing__control_plane_protocols__control_plane_protocol_entry as Protocol
from sorespo.devices.ietf_dm import ietf_routing__routing__control_plane_protocols__control_plane_protocol__isis__interfaces__interface_entry as IsisInterface
from sorespo.devices.ietf_dm import ietf_routing__routing__control_plane_protocols__control_plane_protocol__mpls_ldp__discovery__interfaces__interface_entry as LdpInterface
from sorespo.devices.ietf_dm import ietf_routing__routing__control_plane_protocols__control_plane_protocol__bgp__peer_groups__peer_group_entry as PeerGroup
from sorespo.devices.ietf_dm import ietf_routing__routing__control_plane_protocols__control_plane_protocol__bgp__neighbors__neighbor_entry as Neighbor
from sorespo.devices.ietf_dm import ietf_routing_policy__routing_policy__policy_definitions__policy_definition_entry as Policy
import sorespo.translations.network_data as n
import sorespo.translations.translation_data as d


_ARCOS_LAB_PASSWORD = "$6$OxKlHRd5r/wCpeBE$izoSbxJWOJFrky3R5v/Ool3cG9pBC7pjfp3.o1NG8.ZlPuX28j0lpw0V/zfWGa1PhRfuG2vIxrkS/5n/tr8EF."


def interface_name(interface: Interface) -> str:
    if interface.type == ietf_dm.iana_if_type_softwareLoopback and interface.name == "Loopback0":
        return "loopback0"
    if interface.parent_interface is not None:
        parent, separator, unit = interface.name.rpartition(".")
        if not separator or parent != interface.parent_interface or not n.digits(unit):
            raise ValueError("Subinterface {interface.name} must use parent.<unit> naming")
        return parent
    return interface.name


def interface_index(interface: Interface) -> u64:
    if interface.parent_interface is not None:
        parent, separator, unit = interface.name.rpartition(".")
        return u64(unit)
    return u64(0)


def loopback_address(tree: ietf_dm.root) -> str:
    found: list[str] = []
    for interface in tree.interfaces.interface:
        if interface.type == ietf_dm.iana_if_type_softwareLoopback:
            if interface.ipv4 is not None:
                for address in interface.ipv4!.address:
                    found.append(address.ip)
    if len(found) != 1:
        raise ValueError("ArcOS requires exactly one loopback IPv4 address")
    return found[0]


def local_address(tree: ietf_dm.root, value: ?str) -> ?str:
    if value is None:
        return None
    modeled = tree.interfaces.interface.get(value!)
    if modeled is None:
        return value
    ipv4 = modeled!.ipv4
    if ipv4 is None or len(ipv4!.address) != 1:
        raise ValueError("ArcOS BGP source interface requires exactly one IPv4 address")
    for address in ipv4!.address:
        return address.ip
    return None


def bgp_family(value: Identityref) -> Identityref:
    if value == ietf_dm.iana_bgp_afi_safi_types_ipv4_unicast:
        return arcos8.openconfig_bgp_types_IPV4_UNICAST
    elif value == ietf_dm.iana_bgp_afi_safi_types_l3vpn_ipv4_unicast:
        return arcos8.openconfig_bgp_types_L3VPN_IPV4_UNICAST
    elif value == ietf_dm.iana_bgp_afi_safi_types_l3vpn_ipv6_unicast:
        return arcos8.openconfig_bgp_types_L3VPN_IPV6_UNICAST
    raise ValueError("Unsupported ArcOS BGP family {value}")


mut def system(tree: ietf_dm.root) -> arcos8.root:
    source = d.system_input(tree, network_services=False)
    native = arcos8.root()

    native.features.feature.create(arcos8.arcos_features_ARCOS_RIOT, supported=False)
    native.features.feature.create(arcos8.arcos_features_ARCOS_ICMP_SRC_REWRITE, supported=False)
    native.features.feature.create(arcos8.arcos_features_ARCOS_SUBIF, supported=True)
    native.features.feature.create(arcos8.arcos_features_ARCOS_QoS, supported=False)
    native.features.feature.create(arcos8.arcos_features_ARCOS_MPLS, supported=True)
    native.features.feature.create(arcos8.arcos_features_ARCOS_SFLOW, supported=True)

    native.system.config.hostname = source.hostname
    native.system.config.login_banner = "ArcOS (c) Arrcus, Inc."
    native.system.ssh_server.config.enable = True
    native.system.ssh_server.config.permit_root_login = True
    native.system.ssh_server.sftp.config.enable = True
    native.system.cli.config.commit_message = True
    native.system.netconf_server.config.enable = True
    native.system.netconf_server.transport.ssh.config.enable = True
    native.system.netconf_server.transport.ssh.config.port = 830

    authentication = native.system.aaa.authentication
    authentication.admin_user.config.admin_password = _ARCOS_LAB_PASSWORD
    clab = authentication.users.user.create("clab")
    clab.config.username = "clab"
    clab.config.password = _ARCOS_LAB_PASSWORD
    clab.config.role = arcos8.openconfig_aaa_types_SYSTEM_ROLE_ADMIN

    for family in [arcos8.openconfig_types_IPV6, arcos8.openconfig_types_IPV4]:
        rib = native.system.rib.create(family)
        rib.config.address_family = family

    eth0 = native.interfaces.interface.create("eth0")
    eth0.config.name = "eth0"
    eth0.config.type = arcos8.iana_if_type_ethernetCsmacd
    eth0.config.mtu = 1500
    eth0.config.enabled = True
    eth0.subinterfaces.subinterface.create(0).config.index = 0

    default_ni = native.network_instances.network_instance.create("default")
    default_ni.config.name = "default"
    default_ni.config.type = arcos8.openconfig_network_instance_types_L3VRF
    management_ni = native.network_instances.network_instance.create("management")
    management_ni.config.name = "management"

    lldp = native.lldp.interfaces.interface.create("eth0")
    lldp.config.name = "eth0"

    ipv4 = native.routing_policy.defined_sets.prefix_sets.prefix_set.create("__IPV4_MARTIAN_PREFIX_SET__")
    ipv4.config.prefix_set_name = "__IPV4_MARTIAN_PREFIX_SET__"
    for prefix_value, range_value in [
        ("0.0.0.0/8", "8..32"), ("127.0.0.0/8", "8..32"),
        ("192.0.0.0/24", "24..32"), ("224.0.0.0/4", "exact"),
        ("224.0.0.0/24", "exact"), ("240.0.0.0/4", "4..32")]:
        prefix = ipv4.prefixes.prefix.create((prefix_value, range_value))
        prefix.config.ip_prefix = prefix_value
        prefix.config.masklength_range = range_value

    ipv6 = native.routing_policy.defined_sets.prefix_sets.prefix_set.create("__IPV6_MARTIAN_PREFIX_SET__")
    ipv6.config.prefix_set_name = "__IPV6_MARTIAN_PREFIX_SET__"
    for prefix_value, range_value in [
        ("::/128", "exact"), ("::1/128", "exact"),
        ("ff00::/8", "exact"), ("ff02::/16", "exact")]:
        prefix = ipv6.prefixes.prefix.create((prefix_value, range_value))
        prefix.config.ip_prefix = prefix_value
        prefix.config.masklength_range = range_value
    return native


mut def routing_policy(item: Policy) -> arcos8.root:
    native = arcos8.root()
    target = native.routing_policy.policy_definitions.policy_definition.create(item.name)
    target.config.name = item.name
    for statement in item.statements.statement:
        conditions = statement.conditions
        bgp_conditions = conditions.bgp_conditions
        bgp_actions = statement.actions.bgp_actions
        path = "/routing-policy/policy-definitions/policy-definition[{item.name}]/statements/statement[{statement.name}]"
        d.reject_present([
            ("conditions", conditions.call_policy is not None or
                conditions.source_protocol is not None or
                conditions.match_interface.interface is not None or
                conditions.match_prefix_set.prefix_set is not None or
                conditions.match_prefix_set.match_set_options is not None or
                conditions.match_tag_set.tag_set is not None or
                conditions.match_tag_set.match_set_options is not None or
                bgp_conditions.match_as_path_set.as_path_set is not None or
                bgp_conditions.match_as_path_set.match_set_options is not None or
                bgp_conditions.match_community_set.community_set is not None or
                bgp_conditions.match_community_set.match_set_options is not None),
            ("actions/bgp-actions", bgp_actions.set_route_origin is not None or
                bgp_actions.set_local_pref is not None or
                bgp_actions.set_next_hop is not None or
                bgp_actions.set_med is not None or
                bgp_actions.set_community.options is not None or
                bool(bgp_actions.set_community.community) or
                bgp_actions.set_community.community_set_ref is not None),
        ], path)
        if statement.actions.policy_result != "accept-route":
            raise ValueError("ArcOS routing policies currently support accept-route statements only")
        dest = target.statements.statement.create(statement.name)
        dest.config.name = statement.name
        dest.actions.config.accept_route = True
    return native


mut def interface(interface: Interface) -> arcos8.root:
    native = arcos8.root()
    name = interface_name(interface)
    index = interface_index(interface)
    target = native.interfaces.interface.create(name)
    target.config.name = name
    if interface.parent_interface is None:
        target.config.type = arcos8.iana_if_type_softwareLoopback if interface.type == ietf_dm.iana_if_type_softwareLoopback else arcos8.iana_if_type_ethernetCsmacd
        target.config.description = interface.description
        target.config.enabled = True
    subinterface = target.subinterfaces.subinterface.create(index)
    subinterface.config.index = index
    subinterface.config.description = interface.description
    subinterface.config.enabled = True
    if interface.parent_interface is not None:
        subinterface.vlan.config.vlan_id = index
    if interface.ipv4 is not None:
        subinterface.ipv4.config.enabled = True
        for source in interface.ipv4!.address:
            address = subinterface.ipv4.addresses.address.create(source.ip)
            address.config.ip = source.ip
            address.config.prefix_length = source.prefix_length
    if interface.bind_ni_name is not None:
        ni = native.network_instances.network_instance.create(interface.bind_ni_name!)
        identifier = "{name}.{index}"
        reference = ni.interfaces.interface.create(identifier)
        reference.config.id = identifier
        reference.config.interface = name
        reference.config.subinterface = index
    return native


mut def vpn(tree: ietf_dm.root, instance: NetworkInstance) -> arcos8.root:
    native = arcos8.root()
    ni = native.network_instances.network_instance.create(instance.name)
    ni.config.name = instance.name
    ni.config.type = arcos8.openconfig_network_instance_types_L3VRF
    vpn = instance.vpn!
    if vpn.label_allocation != "per-vrf":
        raise ValueError("ArcOS VRFs require per-vrf label allocation")
    if len(vpn.address_family) != 1:
        raise ValueError("ArcOS VRFs require one IPv4 address family")
    for family in vpn.address_family:
        if len(family.import_route_target) != 1 or family.import_route_target != family.export_route_target:
            raise ValueError("ArcOS VRFs require one identical import/export route target")
        asn, number = n.vpn_numbers(family.import_route_target[0])
        protocol = ni.protocols.protocol.create((arcos8.openconfig_policy_types_BGP, "default"))
        protocol.config.identifier = arcos8.openconfig_policy_types_BGP
        protocol.config.name = "default"
        protocol.bgp.global.config.router_id = loopback_address(tree)
        protocol.bgp.global.config.label_allocation_mode = arcos8.openconfig_network_instance_types_INSTANCE_LABEL
        ipv4 = protocol.bgp.global.afi_safis.afi_safi.create(arcos8.openconfig_bgp_types_IPV4_UNICAST)
        ipv4.config.afi_safi_name = arcos8.openconfig_bgp_types_IPV4_UNICAST
        rt_afi = ipv4.rt_afi_safis.rt_afi_safi.create(arcos8.openconfig_bgp_types_L3VPN_IPV4_UNICAST)
        rt_afi.config.rt_afi_safi_name = arcos8.openconfig_bgp_types_L3VPN_IPV4_UNICAST
        value = "{asn}:{number}"
        route_target = rt_afi.route_targets.route_target.create((value, "both"))
        route_target.config.route_target = value
        route_target.config.route_target_type = "both"
    return native


mut def mpls_interface(tree: ietf_dm.root, interface: MplsInterface) -> arcos8.root:
    if interface.mpls_enabled != True:
        raise ValueError("ArcOS MPLS interfaces require mpls-enabled=true")
    return arcos8.root()


mut def isis(tree: ietf_dm.root, protocol: Protocol) -> arcos8.root:
    native = arcos8.root()
    target = native.network_instances.network_instance.create("default").protocols.protocol.create((arcos8.openconfig_policy_types_ISIS, protocol.name))
    target.config.identifier = arcos8.openconfig_policy_types_ISIS
    target.config.name = protocol.name
    target.isis.global.config.level_capability = "LEVEL_2"
    target.isis.global.config.net = n.net_addresses(protocol)
    ipv4 = target.isis.global.afi_safi.af.create((arcos8.openconfig_isis_types_IPV4, arcos8.openconfig_isis_types_UNICAST))
    ipv4.config.afi_name = arcos8.openconfig_isis_types_IPV4
    ipv4.config.safi_name = arcos8.openconfig_isis_types_UNICAST
    ipv4.config.enabled = True
    level = target.isis.levels.level.create(2)
    level.config.level_number = 2
    level.config.enabled = True
    return native


mut def isis_interface(tree: ietf_dm.root, protocol: Protocol, interface: IsisInterface) -> arcos8.root:
    native = arcos8.root()
    modeled = tree.interfaces.interface.get(interface.name)
    if modeled is None:
        raise ValueError("Missing IS-IS interface {interface.name}")
    name = interface_name(modeled!)
    target = native.network_instances.network_instance.create("default").protocols.protocol.create((arcos8.openconfig_policy_types_ISIS, protocol.name))
    target.config.identifier = arcos8.openconfig_policy_types_ISIS
    target.config.name = protocol.name
    dest = target.isis.interfaces.interface.create(name)
    dest.config.interface_id = name
    dest.config.enabled = True
    dest.config.passive = interface.passive
    if interface.interface_type == "point-to-point":
        dest.config.network_type = "POINT_TO_POINT"
    ipv4 = dest.afi_safi.af.create((arcos8.openconfig_isis_types_IPV4, arcos8.openconfig_isis_types_UNICAST))
    ipv4.config.afi_name = arcos8.openconfig_isis_types_IPV4
    ipv4.config.safi_name = arcos8.openconfig_isis_types_UNICAST
    ipv4.config.enabled = True
    level = dest.levels.level.create(2)
    level.config.level_number = 2
    level.config.enabled = True
    level.config.metric = interface.metric.level_2.value
    return native


mut def ldp(tree: ietf_dm.root, protocol: Protocol) -> arcos8.root:
    native = arcos8.root()
    ni = native.network_instances.network_instance.create("default")
    ni.mpls.global.config.ttl_propagation = True
    ldp = ni.mpls.global.reserved_label_blocks.reserved_label_block.create("LDP")
    ldp.config.local_id = "LDP"
    ldp.config.lower_bound = 16000
    ldp.config.upper_bound = 23999
    ldp.config.usage = arcos8.arcos_mpls_LDP_COMMON
    ldp.config.protocol_identifier = arcos8.arcos_openconfig_policy_types_LDP
    ldp.config.protocol_name = "default"
    bgp = ni.mpls.global.reserved_label_blocks.reserved_label_block.create("BGP")
    bgp.config.local_id = "BGP"
    bgp.config.lower_bound = 24000
    bgp.config.upper_bound = 31999
    bgp.config.usage = arcos8.arcos_mpls_BGP_COMMON
    bgp.config.protocol_identifier = arcos8.openconfig_policy_types_BGP
    bgp.config.protocol_name = "default"
    global_config = ni.mpls.signaling_protocols.ldp.global
    global_config.config.lsr_id = loopback_address(tree)
    global_config.enable.config.enable = True
    global_config.fec_filter.config.export_policy = ["ACCEPT"]
    return native


mut def ldp_interface(tree: ietf_dm.root, protocol: Protocol, interface: LdpInterface) -> arcos8.root:
    native = arcos8.root()
    target = native.network_instances.network_instance.create("default").mpls.signaling_protocols.ldp.interface_attributes.interfaces.interface.create(interface.name)
    target.config.interface_id = interface.name
    target.config.link_hello = True
    ipv4 = target.address_families.address_family.create("IPV4")
    ipv4.config.afi_name = "IPV4"
    ipv4.config.enabled = True
    return native


mut def bgp(tree: ietf_dm.root, protocol: Protocol) -> arcos8.root:
    native = arcos8.root()
    ni = native.network_instances.network_instance.create(protocol.name if protocol.name != "default" else "default")
    target = ni.protocols.protocol.create((arcos8.openconfig_policy_types_BGP, "default"))
    target.config.identifier = arcos8.openconfig_policy_types_BGP
    target.config.name = "default"
    if protocol.name == "default":
        target.bgp.global.config.as_ = n.as_number(protocol)
        target.bgp.global.config.router_id = d.required(protocol.bgp.global!.identifier, "BGP global/identifier")
    for family in protocol.bgp.global!.afi_safis.afi_safi:
        n.enabled_family(family.enabled)
        value = bgp_family(family.name)
        dest = target.bgp.global.afi_safis.afi_safi.create(value)
        dest.config.afi_safi_name = value
    return native


mut def bgp_peer_group(tree: ietf_dm.root, protocol: Protocol, group: PeerGroup) -> arcos8.root:
    native = arcos8.root()
    ni = native.network_instances.network_instance.create(protocol.name if protocol.name != "default" else "default")
    target = ni.protocols.protocol.create((arcos8.openconfig_policy_types_BGP, "default"))
    target.config.identifier = arcos8.openconfig_policy_types_BGP
    target.config.name = "default"
    dest = target.bgp.peer_groups.peer_group.create(group.name)
    dest.config.peer_group_name = group.name
    dest.config.peer_as = group.peer_as
    dest.transport.config.local_address = local_address(tree, group.transport.local_address)
    security = group.transport.secure_session
    dest.config.auth_password = n.password(tree, security.enabled, security.options.md5_keychain)
    for family in group.afi_safis.afi_safi:
        n.enabled_family(family.enabled)
        value = bgp_family(family.name)
        item = dest.afi_safis.afi_safi.create(value)
        item.config.afi_safi_name = value
    return native


mut def bgp_neighbor(tree: ietf_dm.root, protocol: Protocol, peer: Neighbor) -> arcos8.root:
    native = arcos8.root()
    ni = native.network_instances.network_instance.create(protocol.name if protocol.name != "default" else "default")
    target = ni.protocols.protocol.create((arcos8.openconfig_policy_types_BGP, "default"))
    target.config.identifier = arcos8.openconfig_policy_types_BGP
    target.config.name = "default"
    dest = target.bgp.neighbors.neighbor.create(peer.remote_address!)
    dest.config.neighbor_address = peer.remote_address
    dest.config.peer_group = peer.peer_group
    dest.config.peer_as = peer.peer_as
    dest.config.description = peer.description
    dest.as_path_options.config.replace_peer_as = peer.as_path_options.replace_peer_as
    security = peer.transport.secure_session
    dest.config.auth_password = n.password(tree, security.enabled, security.options.md5_keychain)
    if peer.timers.hold_time is not None or peer.timers.keepalive is not None:
        raise ValueError("ArcOS neighbor timers are not available in the selected device schema")
    if len(peer.afi_safis.afi_safi) > 0:
        for family in peer.afi_safis.afi_safi:
            n.enabled_family(family.enabled)
            value = bgp_family(family.name)
            item = dest.afi_safis.afi_safi.create(value)
            item.config.afi_safi_name = value
            item.apply_policy.config.import_policy = family.apply_policy.import_policy
            item.apply_policy.config.export_policy = family.apply_policy.export_policy
    elif peer.peer_group is not None:
        group = protocol.bgp.peer_groups.peer_group.get(peer.peer_group!)
        if group is not None:
            for family in group!.afi_safis.afi_safi:
                n.enabled_family(family.enabled)
                value = bgp_family(family.name)
                item = dest.afi_safis.afi_safi.create(value)
                item.config.afi_safi_name = value
                item.apply_policy.config.import_policy = family.apply_policy.import_policy
                item.apply_policy.config.export_policy = family.apply_policy.export_policy
    return native
